@model MINSUE_ProHub.Models.SignUpViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mindoro State University</title>
    <link rel="stylesheet" href="~/css/signup.css?v=2" />
</head>
<body>
    <div class="signup-container">
        <div class="left-panel-signup">
            <div class="signup-form">
                <h2>Sign up</h2>

                <form asp-action="SignUp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label asp-for="Username">Username:</label>
                        <div class="input-wrapper">
                            <input asp-for="Username" class="form-control" required autocomplete="off" />
                            <span class="input-icon">👤</span>
                        </div>
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StudentEmployeeId">Student/Employee ID:</label>
                        <div class="input-wrapper">
                            <input asp-for="StudentEmployeeId" class="form-control" required autocomplete="off"/>
                            <span class="input-icon">🪪</span>
                        </div>
                        <span asp-validation-for="StudentEmployeeId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email">Email:</label>
                        <div class="input-wrapper">
                            <input asp-for="Email" class="form-control" required autocomplete="off" />
                            <span class="input-icon">📧</span>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Password:</label>
                        <div class="input-wrapper">
                            <input asp-for="Password" class="form-control" required autocomplete="off"/>
                            <span class="input-icon">🔒</span>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="forgot-password">
                        <a asp-action="ForgotPassword">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn-login">Sign up</button>

                   
                </form>
            </div>
        </div>

        <div class="right-panel-signup">
            <div class="logo-section">
                <img src="~/images/logominsu.png" alt="Mindoro State University" class="logo" height="350px" width="350px" />
                <h1>Welcome to MINSU E-ProHub</h1>
                <p>Already have an account?</p>
                <a asp-controller="Account" asp-action="Login" class="btn-login-link">Login</a>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>