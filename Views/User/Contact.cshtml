@{
    ViewData["Title"] = "Contact Us - MINSU E-ProHub";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Contact MINSU E-ProHub - Get in touch with us" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/contact.css" />
    <link rel="icon" href="~/images/logo.png" type="image/png" />
</head>
<body>
    <!-- Navigation Bar - Same as Homepage -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("homepage", "User")">
                <img src="~/images/logo.png" alt="MINSU Logo" class="navbar-logo">
                <span class="brand-text">MINSU E-ProHub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("homepage", "User")" data-page="homepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "User")" data-page="about">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Product", "User")" data-page="product">Product</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Contact", "User")" data-page="contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Profile", "User")" data-page="profile">Profile</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="hero-content text-center">
                <div class="hero-badge fade-in">📞 Contact Us</div>
                <h1 class="hero-title fade-in-delay-1">Get In Touch</h1>
                <p class="hero-description fade-in-delay-2">
                    Have questions? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
                </p>
            </div>
        </div>
        <div class="decoration-circle circle-1"></div>
        <div class="decoration-circle circle-2"></div>
    </section>

    <!-- Main Content -->
    <section class="main-content">
        <div class="container">
            <div class="contact-grid">
                <!-- Contact Information -->
                <div class="contact-info">
                    <div class="info-card fade-in-up">
                        <h3>Contact Information</h3>

                        <div class="info-item">
                            <div class="info-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Address</h4>
                                <p>Mindoro State University<br>Main Campus, Oriental Mindoro<br></p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Phone</h4>
                                <p>+63 (43) 123-4567<br>Mobile: +63 917-123-4567</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Email</h4>
                                <p>eprohub@minsu.edu.ph<br>support@minsu-eprohub.com</p>
                            </div>
                        </div>

                        <div class="info-item">
                            <div class="info-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                            <div class="info-content">
                                <h4>Office Hours</h4>
                                <p>Monday - Friday: 8:00 AM - 5:00 PM<br>Saturday: 8:00 AM - 12:00 PM<br>Sunday: Closed</p>
                            </div>
                        </div>
                    </div>

                    <div class="quick-support fade-in-up">
                        <h3>Quick Support</h3>
                        <ul>
                            <li>📚 <a href="#faq">Frequently Asked Questions</a></li>
                            <li>📦 <a href="#orders">Order Tracking</a></li>
                            <li>💳 <a href="#payment">Payment Methods</a></li>
                            <li>🚚 <a href="#delivery">Delivery Information</a></li>
                        </ul>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form-wrapper">
                    <div class="contact-form-container fade-in-up">
                        <h3>Send Us a Message</h3>
                        <form action="@Url.Action("Submit", "Contact")" method="POST">
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="name">Full Name *</label>
                                    <input type="text" id="name" name="name" placeholder="Juan Dela Cruz" required>
                                </div>
                                <div class="form-group">
                                    <label for="email">Email Address *</label>
                                    <input type="email" id="email" name="email" placeholder="juan@example.com" required>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="subject">Subject *</label>
                                <input type="text" id="subject" name="subject" placeholder="Order Inquiry, Product Question, etc." required>
                            </div>

                            <div class="form-group">
                                <label for="message">Message *</label>
                                <textarea id="message" name="message" placeholder="Please provide details about your inquiry..." required></textarea>
                            </div>

                            <div class="form-group checkbox-group">
                                <input type="checkbox" id="privacy" name="privacy" required>
                                <label for="privacy">I agree to the privacy policy and consent to the collection and use of my personal information. *</label>
                            </div>

                            <button type="submit" class="submit-btn">📤 Send Message</button>
                        </form>
                    </div>

                    <!-- Map Section -->
                    <div class="map-section fade-in-up">
                        <h3>Find Us Here</h3>
                        <div class="map-placeholder">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <p><strong>Mindoro State University</strong></p>
                            <p>Main Campus, Oriental Mindoro</p>
                            <a href="https://maps.google.com/?q=Mindoro+State+University" target="_blank" class="map-link">Open in Google Maps →</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

   

    <!-- Scroll to Top Button -->
    <div class="scroll-top" id="scrollTop">↑</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/home.js"></script>
</body>
</html>