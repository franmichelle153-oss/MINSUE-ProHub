@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Products - MINSU E-ProHub";
    Layout = null;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Browse and reserve production office equipment and supplies at MINSU E-ProHub" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="stylesheet" href="~/css/product.css?v=2" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    

    <link rel="icon" href="~/images/logominsu.png" type="image/png" />
</head>
<body>
    <input type="hidden" name="__RequestVerificationToken" value="@token" />

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("homepage", "User")">
                <img src="~/images/logominsu.png" alt="MINSU Logo" class="navbar-logo">
                <span class="brand-text">MINSU E-ProHub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("homepage", "User")" data-page="homepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "User")" data-page="about">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Product", "User")" data-page="product">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "User")" data-page="contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Profile", "User")" data-page="profile">Profile</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 mx-auto text-center">
                    <div class="header-badge fade-in">🛍️ Our Products</div>
                    <h1 class="page-title fade-in-delay-1">School Supplies & Uniforms</h1>
                    <p class="page-subtitle fade-in-delay-2">
                        Browse our complete catalog of student essentials available for reservation and purchase
                    </p>
                </div>
            </div>
        </div>
        <div class="decoration-circle circle-1"></div>
        <div class="decoration-circle circle-2"></div>
    </section>

    <!-- Filter & Search Section -->
    <section class="filter-section">
        <div class="container">
            <div class="filter-box fade-in-up">
                <div class="row align-items-center g-3">
                    <div class="col-lg-6">
                        <div class="search-wrapper">
                            <input type="text" id="searchProduct" class="search-input" placeholder="Search products...">
                            <span class="search-icon">🔍</span>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="filter-buttons">
                            <button class="filter-btn active" data-filter="all">
                                <span class="filter-icon">📦</span> All Products
                            </button>
                            <button class="filter-btn" data-filter="uniform">
                                <span class="filter-icon">👔</span> Uniforms
                            </button>
                            <button class="filter-btn" data-filter="supplies">
                                <span class="filter-icon">📝</span> Supplies
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Products Grid Section -->
    <section class="products-section">
        <div class="container">
            <!-- Student ID -->
            <div class="product-item fade-in-up" data-category="supplies" data-product-id="1" data-name="Student ID">
                <div class="product-card">
                    <div class="product-badge">🆕 Essential</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">🪪</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Student/Employee ID</h3>
                        <p class="product-category">Official Identification</p>
                        <p class="product-description">
                            Official MINSU student identification card with photo and student number. Required for campus access and transactions.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Photo ID</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱100.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Student ID')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Uniform Blouse (Female) -->
            <div class="product-item fade-in-up" data-category="uniform" data-product-id="7" data-name="Uniform Blouse Female">
                <div class="product-card">
                    <div class="product-badge">👚 Uniform</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">👚</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Uniform Blouse (Female)</h3>
                        <p class="product-category">Girls' Uniform</p>
                        <p class="product-description">
                            Official MINSU white blouse for female students. Made from high-quality, breathable fabric. Available in multiple sizes.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Small - XXL</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱450.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Uniform Blouse Female')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Uniform Shirt (Male) -->
            <div class="product-item fade-in-up" data-category="uniform" data-product-id="3" data-name="Uniform Shirt Male">
                <div class="product-card">
                    <div class="product-badge">👕 Uniform</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">👕</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Uniform Polo (Male)</h3>
                        <p class="product-category">Boys' Uniform</p>
                        <p class="product-description">
                            Official MINSU white polo shirt for male students. Premium fabric with excellent fit and comfort. Multiple sizes available.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Small - XXL</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱450.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Uniform Shirt Male')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Uniform Pants -->
            <div class="product-item fade-in-up" data-category="uniform" data-product-id="4" data-name="Uniform Pants">
                <div class="product-card">
                    <div class="product-badge">👖 Uniform</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">👖</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Uniform Pants</h3>
                        <p class="product-category">Unisex Uniform</p>
                        <p class="product-description">
                            Official MINSU dark green pants for all students. Comfortable fit with reinforced stitching. Available in various sizes.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ 24-38 Waist</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱550.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Uniform Pants')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Uniform Skirt -->
            <div class="product-item fade-in-up" data-category="uniform" data-product-id="5" data-name="Uniform Skirt">
                <div class="product-card">
                    <div class="product-badge">👗 Uniform</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">👗</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Uniform Skirt</h3>
                        <p class="product-category">Girls' Uniform</p>
                        <p class="product-description">
                            Official MINSU dark green skirt for female students. Knee-length with pleated design. Quality fabric with proper lining.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Small - XL</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱500.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Uniform Skirt')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PE -->
            <div class="product-item fade-in-up" data-category="uniform" data-product-id="6" data-name="PE Uniform">
                <div class="product-card">
                    <div class="product-badge">👕🩳 Uniform</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">👕🩳</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">PE Uniform</h3>
                        <p class="product-category">Activewear Comfort</p>
                        <p class="product-description">
                            Official MINSU pe pants for all students. Comfortable fit with reinforced stitching. Available in various sizes.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Small - XL</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱650.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('PE Uniform')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lace -->
            <div class="product-item fade-in-up" data-category="supplies" data-product-id="7" data-name="School Lace">
                <div class="product-card">
                    <div class="product-badge">🧵 Accessory</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">🧵</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">School Lace</h3>
                        <p class="product-category">Uniform Accessory</p>
                        <p class="product-description">
                            Official MINSU lace for uniform. High-quality material with proper width and length. Essential uniform accessory.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ Official Color</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱90.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('School Lace')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stationary Papers -->
            <div class="product-item fade-in-up" data-category="supplies" data-product-id="8" data-name="Stationary Papers">
                <div class="product-card">
                    <div class="product-badge">📄 Supplies</div>
                    <div class="product-image-wrapper">
                        <div class="product-icon">📄</div>
                    </div>
                    <div class="product-content">
                        <h3 class="product-name">Stationary Papers</h3>
                        <p class="product-category">School Supplies</p>
                        <p class="product-description">
                            Premium quality ruled and plain paper for school use. Available in packs of 100 sheets. Perfect for assignments and projects.
                        </p>
                        <div class="product-features">
                            <span class="feature-tag">✓ 100 Sheets</span>
                            <span class="feature-tag">✓ A4 Size</span>
                        </div>
                        <div class="product-footer">
                            <div class="product-price">₱100.00</div>
                            <button class="btn-reserve" onclick="reserveProduct('Stationary Papers')">
                                <span class="btn-icon">📅</span> Reserve Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2 class="cta-title">Need Help Choosing?</h2>
                        <p class="cta-description">Our team is ready to assist you with product inquiries and reservations</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="@Url.Action("Contact", "User")" class="btn-custom btn-primary-custom">
                            💬 Contact Support
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reservation Modal -->
    <div class="modal fade" id="reservationModal" tabindex="-1">
        <div class="modal-dialog">
     <div class="modal-content">
       <div class="modal-header">
    <h5 class="modal-title">Reserve Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
   <div class="modal-body">
     <form id="reservationForm">
            <input type="hidden" id="productId" name="productId" />
         <div class="mb-3">
<label for="studentName" class="form-label">Student Name</label>
    <input type="text" class="form-control" id="studentName" name="studentName" required>
     </div>
            <div class="mb-3">
     <label for="studentId" class="form-label">Student ID</label>
             <input type="text" class="form-control" id="studentId" name="studentId" required>
      </div>
<div class="mb-3">
    <label for="email" class="form-label">Email</label>
      <input type="email" class="form-control" id="email" name="email" required>
     </div>
   <div class="mb-3">
      <label for="yearLevel" class="form-label">Year Level</label>
      <select class="form-select" id="yearLevel" name="yearLevel" required>
    <option value="">Select Year Level</option>
             <option value="1st Year">1st Year</option>
           <option value="2nd Year">2nd Year</option>
   <option value="3rd Year">3rd Year</option>
             <option value="4th Year">4th Year</option>
         </select>
       </div>
            <div class="mb-3">
    <label for="quantityOrder" class="form-label">Quantity</label>
        <input type="number" class="form-control" id="quantityOrder" name="quantityOrder" min="1" required>
        </div>
             <div class="mb-3">
            <label for="dateToClaim" class="form-label">Date to Claim</label>
        <input type="text" class="form-control" id="dateToClaim" name="dateToClaim" required>
 </div>
       </form>
      </div>
     <div class="modal-footer">
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
     <button type="button" class="btn btn-primary" id="submitReservation">Submit Reservation</button>
        </div>
          </div>
   </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
     <div class="modal-content">
<div class="modal-header">
  <h5 class="modal-title">Reservation Successful</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
   <div class="modal-body">
        <p>Your reservation has been successfully submitted!</p>
        </div>
          <div class="modal-footer">
                  <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
                </div>
     </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
     // Initialize date picker
     flatpickr("#dateToClaim", {
    minDate: "today",
            dateFormat: "Y-m-d",
     altInput: true,
         altFormat: "F j, Y"
       });

            // Function to handle product reservation
    window.reserveProduct = function(productName) {
  // Find the product item element
     const productItem = Array.from(document.querySelectorAll('.product-item'))
  .find(item => item.dataset.name === productName);
    
      if (productItem) {
         // Set the product ID in the form
       document.getElementById('productId').value = productItem.dataset.productId;
   // Show the reservation modal
    new bootstrap.Modal(document.getElementById('reservationModal')).show();
     }
        };

  // Function to display validation errors
      function displayValidationErrors(form, errors) {
   // Clear existing error messages
   const existingErrors = form.querySelectorAll('.validation-error');
    existingErrors.forEach(el => el.remove());

   // Add new error messages
     errors.forEach(error => {
   const input = form.querySelector(`[name="${error.field}"]`);
    if (input) {
    const errorDiv = document.createElement('div');
        errorDiv.className = 'validation-error text-danger small mt-1';
  errorDiv.textContent = error.message;
   input.parentNode.appendChild(errorDiv);
        input.classList.add('is-invalid');
       }
    });
       }

            // Clear validation errors when input changes
    document.querySelectorAll('#reservationForm input, #reservationForm select').forEach(input => {
        input.addEventListener('input', function() {
 this.classList.remove('is-invalid');
          const errorDiv = this.parentNode.querySelector('.validation-error');
 if (errorDiv) {
        errorDiv.remove();
    }
     });
    });

     // Handle form submission
  document.getElementById('submitReservation').addEventListener('click', async function() {
    const form = document.getElementById('reservationForm');
  const submitButton = this;
      
  // Clear existing errors
     document.querySelectorAll('.validation-error').forEach(el => el.remove());
       document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

       if (!form.checkValidity()) {
  form.reportValidity();
         return;
       }

  // Disable submit button and show loading state
   submitButton.disabled = true;
    submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Submitting...';

     try {
      const formData = {
  productId: parseInt(document.getElementById('productId').value),
     studentName: document.getElementById('studentName').value,
      studentId: document.getElementById('studentId').value,
email: document.getElementById('email').value,
      yearLevel: document.getElementById('yearLevel').value,
    quantityOrder: parseInt(document.getElementById('quantityOrder').value),
     dateToClaim: document.getElementById('dateToClaim').value
         };

    const response = await fetch('/api/ReservationApi', {
   method: 'POST',
   headers: {
'Content-Type': 'application/json',
      'RequestVerificationToken': '@token'
    },
     body: JSON.stringify(formData)
           });

        // Get the response text once
  const responseText = await response.text();
           let result;

         try {
     // Try to parse the response text as JSON
  result = JSON.parse(responseText);
     } catch (e) {
     result = {
   success: false,
          message: 'Server returned an invalid response',
              error: responseText
          };
    }

if (response.ok && result.success) {
     // Show success modal
         bootstrap.Modal.getInstance(document.getElementById('reservationModal')).hide();
     new bootstrap.Modal(document.getElementById('successModal')).show();
        form.reset();
        } else {
 // Handle validation errors
   if (result.errors && Array.isArray(result.errors)) {
      const validationErrors = result.errors.map(error => {
       const [field, message] = error.split(':').map(s => s.trim());
    return { field, message };
    });
     displayValidationErrors(form, validationErrors);
     } else {
   alert(result.message || 'An error occurred while submitting the reservation');
       }
  }
        } catch (error) {
        alert('Network error while submitting reservation: ' + error.message);
        } finally {
// Re-enable submit button and restore text
   submitButton.disabled = false;
    submitButton.innerHTML = 'Submit Reservation';
        }
    });
        });
    </script>

    <style>
        .validation-error {
         color: #dc3545;
      font-size: 0.875rem;
     margin-top: 0.25rem;
        }

        .is-invalid {
        border-color: #dc3545;
        }
    </style>
</body>
</html>