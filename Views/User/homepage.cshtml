@{
    ViewData["Title"] = "MINSU E-ProHub - Online Reservation System";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MINSU E-ProHub - Streamline your production office equipment and facility reservations online" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/home.css" />
    <link rel="icon" href="~/images/logominsu.png" type="image/png" />
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("homepage", "User")">
                <img src="~/images/logominsu.png" alt="MINSU Logo" class="navbar-logo">
                <span class="brand-text">MINSU E-ProHub</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("homepage", "User")" data-page="homepage">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("About", "User")" data-page="about">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Product", "User")" data-page="product">Product</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "User")" data-page="contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Profile", "User")" data-page="profile">Profile</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <div class="hero-badge fade-in">🎓 Mindoro State University</div>
                        <h1 class="hero-title fade-in-delay-1">E-ProHub</h1>
                        <h2 class="hero-subtitle fade-in-delay-2">
                            Smart <strong>Online Reservation</strong> for Production Office
                        </h2>
                        <p class="hero-description fade-in-delay-2">
                            Simplify your workflow with our comprehensive online reservation platform. Book production equipment, studio facilities, and resources effortlessly. Available 24/7 for MINSU students and faculty.
                        </p>
                        <div class="button-group fade-in-delay-3">
                            <a href="@Url.Action("Product", "User")" class="btn-custom btn-primary-custom">
                                📅 Reserve Now
                            </a>
                            <a href="@Url.Action("About", "User")" class="btn-custom btn-outline-custom">
                                💡 Learn More
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="logo-container fade-in-delay-2">
                        <img src="~/images/logominsu.png" alt="Mindoro State University" class="minsu-logo" />
                    </div>
                </div>
            </div>
        </div>
        <div class="decoration-circle circle-1"></div>
        <div class="decoration-circle circle-2"></div>
        <div class="decoration-circle circle-3"></div>
    </section>

    <!-- Story Section -->
    <section class="story-section">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 fade-in-up">
                    <div class="story-image-wrapper">
                        <div class="story-image-placeholder">
                            <div class="placeholder-icon">🏛️</div>
                            <p class="placeholder-text">MINSU Production Office</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 fade-in-up">
                    <div class="section-badge">📚 Our Story</div>
                    <h2 class="section-title">From Inconvenience to Innovation</h2>
                    <div class="story-content">
                        <p>
                            The idea for E-ProHub came from a simple yet meaningful observation  many students often go to the Production Office to avail products such as IDs and uniforms, only to find out that the items they need aren’t available. This often leads to wasted time and effort, especially since the office is quite far for some students.
                        </p>
                        <p>
                            Seeing this challenge, our team wanted to create a system that would make the process more convenient and reliable. With E-ProHub, students can now check the availability of products and even reserve them online before going to the office. This way, when they visit, they can simply claim their reserved items saving both time and energy, and avoiding unnecessary trips.
                        </p>
                        <p>
                            What started as a simple idea to help our fellow students has grown into a system that combines accessibility, efficiency, and innovation. E-ProHub reflects our goal to make campus processes smoother, smarter, and more student-friendly — one click at a time.
                        </p>
                       
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonial-section">
        <div class="container">
            <div class="section-header">
                <div class="section-badge">💬 Testimonials</div>
                <h2 class="section-title">What Our Users Say</h2>
                <p class="section-subtitle">
                    Real experiences from students and faculty members who use E-ProHub
                </p>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="testimonial-card">
                        <p class="testimonial-text">
                            "E-ProHub revolutionized how we manage our thesis video production. The booking process is incredibly smooth, and we always get the equipment we need on time. Highly recommended!"
                        </p>
                        <div class="testimonial-author-box">
                            <div class="testimonial-avatar">MS</div>
                            <div>
                                <div class="testimonial-author">Maria Santos</div>
                                <div class="testimonial-role">BS Communication Arts Student</div>
                                <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="testimonial-card">
                        <p class="testimonial-text">
                            "As a faculty member, I appreciate how organized and efficient the system is. The real-time availability feature saves us hours of coordination time. Truly a game-changer!"
                        </p>
                        <div class="testimonial-author-box">
                            <div class="testimonial-avatar">JR</div>
                            <div>
                                <div class="testimonial-author">Prof. Juan Reyes</div>
                                <div class="testimonial-role">Production Office Staff</div>
                                <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="testimonial-card">
                        <p class="testimonial-text">
                            "The mobile-friendly interface makes it so easy to check equipment availability between classes. I've used it for multiple org events, and it never disappoints. Excellent platform!"
                        </p>
                        <div class="testimonial-author-box">
                            <div class="testimonial-avatar">AC</div>
                            <div>
                                <div class="testimonial-author">Anna Cruz</div>
                                <div class="testimonial-role">Student Council President</div>
                                <div class="testimonial-rating">⭐⭐⭐⭐⭐</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
   

    <!-- Services/Equipment Section -->
    <section class="services-section">
        <div class="container">
            <div class="section-header">
                <div class="section-badge text-white">🎓 PRODUCTION OFFICE RESOURCES</div>
                <h2 class="section-title text-green">Available Products</h2>
                <p class="section-subtitle text-black">
                    Easily reserve your ID, uniform, and other production items anytime, anywhere
                </p>
            </div>
            <div class="row g-4">
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">👚👖👗</div>
                        <div class="service-content">
                            <h3 class="service-name">Women’s School Uniform</h3>
                            <div class="service-price">Blouse,Pants & Skirt Set</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">👕👖</div>
                        <div class="service-content">
                            <h3 class="service-name">Men’s School Uniform</h3>
                            <div class="service-price">Polo & Pants Set</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">👕🩳</div>
                        <div class="service-content">
                            <h3 class="service-name">PE Uniform</h3>
                            <div class="service-price">Activewear Comfort</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">📄</div>
                        <div class="service-content">
                            <h3 class="service-name">Stationary Paper</h3>
                            <div class="service-price">Study Essentials</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">🪪</div>
                        <div class="service-content">
                            <h3 class="service-name">Student ID</h3>
                            <div class="service-price">Identification Made Easy</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 fade-in-up">
                    <div class="service-card">
                        <div class="service-icon-bg">🧵</div>
                        <div class="service-content">
                            <h3 class="service-name">ID Lace</h3>
                            <div class="service-price">Official University Design</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-box">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2 class="cta-title">Ready to Start Your Creative Journey?</h2>
                        <p class="cta-description">Join hundreds of students and faculty already using E-ProHub to bring their creative visions to life</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="@Url.Action("Product", "User")" class="btn-custom btn-primary-custom">
                            📅 Reserve Now
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer (From Home Page) -->
    
    

    <!-- Scroll to Top Button -->
    <div class="scroll-top" id="scrollTop">↑</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/home.js"></script>
</body>
</html>